FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app


WORKDIR /app

# ---------------------------------------------------------
# Install system dependencies
# ---------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------
# Install Python dependencies (cached layer)
# ---------------------------------------------------------
COPY requirements-base.txt requirements-api.txt  /app/

RUN pip install --no-cache-dir --upgrade pip==24.0 && \
    pip install --no-cache-dir \
        -r requirements-base.txt \
        -r requirements-api.txt 

# ---------------------------------------------------------
# Copy application code
# ---------------------------------------------------------
COPY . /app

# ---------------------------------------------------------
# Create non-root user
# ---------------------------------------------------------
RUN useradd -m appuser

# Named volumes (product_memory, qdrant_storage) get created root-owned by
# the Docker daemon on first use, and USER below means the app never runs
# as root again to fix that itself. A NEW volume inherits ownership from
# whatever's already at the mount path in the image at the time it's first
# mounted -- so the mkdir has to happen before USER appuser.
#
# The chown is deliberately scoped to the whole /app tree, not just
# artifacts/ -- COPY . /app above runs as root with no --chown flag, so
# EVERYTHING it copied in (including data/eval/, where the evaluation
# judges write their cache files) stayed root-owned too. A narrower chown
# limited to artifacts/ was what caused a real PermissionError on
# data/eval/faithfulness_cache.json -- the underlying cause is broader
# than just the two volume mount points, so the fix needs to be too.
RUN mkdir -p /app/artifacts/memory /app/artifacts/qdrant_storage && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

# ---------------------------------------------------------
# Healthcheck
# ---------------------------------------------------------
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# ---------------------------------------------------------
# Start API
# ---------------------------------------------------------
CMD ["python", "-m", "uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]